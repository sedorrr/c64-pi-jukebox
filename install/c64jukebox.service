[Unit]
Description=C64-Jukebox (SID-Jukebox für die Ultimates, Stream-Verteiler für die Picos)
After=network-online.target avahi-daemon.service c64pi-net.service
Wants=network-online.target

[Service]
User=c64jukebox
Group=c64jukebox
# i2c: the small OLED display; spi + gpio: the 2.8" touch display; video: /dev/cec0 (the TV's remote, cec.py)
SupplementaryGroups=i2c spi gpio video
WorkingDirectory=/opt/c64jukebox
ExecStart=/opt/c64jukebox/venv/bin/python -m c64jukebox --data /var/lib/c64jukebox --port 80
# port 80 without root; raw packets: tell a hanging Ultimate where the Pi is (arpfix.py)
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW
Restart=always
RestartSec=3
MemoryMax=400M
Nice=-5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/c64jukebox -/run/c64pi

[Install]
WantedBy=multi-user.target
